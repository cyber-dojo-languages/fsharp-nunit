FROM ghcr.io/cyber-dojo-languages/fsharp:2de6d43@sha256:bcab3fd5fd8bb70c68fb5dba5f8ff2650c1eb4ea0956b63a789a2f08b540413c
LABEL maintainer=jon@jaggersoft.com

USER sandbox
COPY . .
RUN ./install.sh

# /versions.json belongs to root, so the packages install.sh put in the
# sandbox user's NuGet cache are recorded as root, and the image then goes
# back to the sandbox user it ran as before.
USER root
RUN bash ./record_versions.sh && rm ./record_versions.sh
USER sandbox
